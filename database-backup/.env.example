# ============================================================================
# Database Backup/Restore - Local Environment Template
# ============================================================================
# 1) Copy this file to .env.local
# 2) Fill with real credentials locally
# 3) Never commit .env.local
# ============================================================================

# Source database (backup)
SOURCE_DB_HOST=aws-0-us-west-2.pooler.supabase.com
SOURCE_DB_PORT=5432
SOURCE_DB_USER=postgres.ykalocfhnetxenvmtlcn
SOURCE_DB_NAME=postgres
SOURCE_DB_PASSWORD=CHANGE_ME_SOURCE_DB_PASSWORD

# Target database (restore)
TARGET_DB_HOST=aws-1-us-east-2.pooler.supabase.com
TARGET_DB_PORT=5432
TARGET_DB_USER=postgres.bqeemgkbzshupjrjxmuv
TARGET_DB_NAME=postgres
TARGET_DB_PASSWORD=CHANGE_ME_TARGET_DB_PASSWORD

# Backup settings
BACKUP_SCHEMA=public
BACKUP_FORMAT=c
COMPRESSION_LEVEL=6
BACKUP_DIR=./backups
LOG_DIR=./logs
KEEP_BACKUPS=7

# Connection settings
PGSSLMODE=require
CONNECT_TIMEOUT=30

# Advanced options
CLEAN_BEFORE_CREATE=false
CREATE_DATABASE=false
INCLUDE_BLOBS=true
VERBOSE=true

# Optional notifications
NOTIFICATION_EMAIL=
NOTIFICATION_WEBHOOK=
