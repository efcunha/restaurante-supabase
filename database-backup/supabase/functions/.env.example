# Supabase runtime
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (test or production depending on environment)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=

# Required hardening for browser calls to edge functions.
# Comma-separated whitelist of browser origins, without trailing slash.
# Example: https://ops.restaurante-web.app.br,https://restaurante-web.app.br,http://localhost:8081
CORS_ALLOWED_ORIGINS=

# ── Contact Form (send-contact) ──────────────────────────────
# Resend API key for sending emails (get free key at https://resend.com)
RESEND_API_KEY=

# Email that appears as sender
CONTACT_FROM_EMAIL=contato@restaurante-web.app.br

# Email that receives the contact messages
CONTACT_TO_EMAIL=contato@restaurante-web.app.br

# CORS origins allowed to call send-contact (comma-separated, no trailing slash)
CONTACT_CORS_ORIGINS=https://restaurante-web.app.br,http://localhost:3000
