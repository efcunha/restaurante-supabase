# Supabase runtime
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (test or production depending on environment)
MERCADOPAGO_ACCESS_TOKEN=
