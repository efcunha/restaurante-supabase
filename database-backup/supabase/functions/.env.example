# Required hardening for browser calls to edge functions.
# Comma-separated whitelist of browser origins, without trailing slash.
# Example: https://ops.restaurante-web.app.br,https://restaurante-web.app.br,http://localhost:8081
CORS_ALLOWED_ORIGINS=
