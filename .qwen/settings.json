{
  "permissions": {
    "allow": [
      "Bash(mkdir *)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "WebSearch",
      "WebFetch(www.adspower.com)",
      "WebFetch(www.w3cschool.cn)",
      "WebFetch(lumadock.com)",
      "WebFetch(almcorp.com)",
      "Read(c:\\Users\\ECUNHA\\.vscode\\extensions\\qwenlm.qwen-code-vscode-ide-companion-0.14.2-win32-x64\\dist\\qwen-cli\\bundled\\qc-helper\\docs\\features/**)",
      "Bash(npx *)",
      "Bash(node *)",
      "Read(c:\\Users\\ECUNHA\\.vscode\\extensions\\qwenlm.qwen-code-vscode-ide-companion-0.14.4-win32-x64\\dist\\qwen-cli\\bundled\\qc-helper\\docs\\features/**)"
    ]
  },
  "mcpServers": {
    "supabaseMcpServer": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "${env:SUPABASE_ACCESS_TOKEN}"
      ],
      "env": {},
      "type": "stdio"
    },
    "playwrightMcp": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "type": "stdio"
    },
    "railway": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@railway/mcp-server"
      ],
      "env": {
        "RAILWAY_TOKEN": "${env:RAILWAY_TOKEN}"
      }
    },
    "activepieces": {
      "httpUrl": "https://activepieces-production-4e63.up.railway.app/api/v1/projects/aqW21pXGsiXLhvorLCeIo/mcp-server/http",
      "headers": {
        "Authorization": "Bearer ${env:ACTIVEPIECES_BEARER}"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest",
        "--api-key",
        "${env:CONTEXT7_API_KEY}"
      ],
      "type": "stdio"
    },
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--figma-api-key",
        "${env:FIGMA_API_KEY}",
        "--stdio"
      ],
      "type": "stdio"
    },
    "sentry": {
      "command": "npx",
      "args": [
        "-y",
        "@sentry/mcp-server@latest"
      ],
      "env": {
        "SENTRY_ACCESS_TOKEN": "${env:SENTRY_ACCESS_TOKEN}",
        "OPENAI_API_KEY": "${env:OPENAI_API_KEY}",
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "type": "stdio"
    }
  },
  "$version": 3
}