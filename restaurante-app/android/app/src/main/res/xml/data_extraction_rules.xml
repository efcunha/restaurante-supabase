<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12+.
  Valid schema for android:dataExtractionRules.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="EncryptedSharedPreferences.xml" />
    <exclude domain="sharedpref" path="biometric" />
    <exclude domain="sharedpref" path="session" />
    <exclude domain="sharedpref" path="auth" />
    <exclude domain="sharedpref" path="token" />
    <exclude domain="sharedpref" path="secret" />

    <exclude domain="file" path="expo/session" />
    <exclude domain="file" path="expo/auth" />
    <exclude domain="file" path="expo/credentials" />
    <exclude domain="file" path="RCTAsyncLocalStorage" />
  </cloud-backup>

  <device-transfer>
    <exclude domain="sharedpref" path="EncryptedSharedPreferences.xml" />
    <exclude domain="sharedpref" path="biometric" />
    <exclude domain="sharedpref" path="session" />
    <exclude domain="sharedpref" path="auth" />
    <exclude domain="sharedpref" path="token" />
    <exclude domain="sharedpref" path="secret" />

    <exclude domain="file" path="expo/session" />
    <exclude domain="file" path="expo/auth" />
    <exclude domain="file" path="expo/credentials" />
    <exclude domain="file" path="RCTAsyncLocalStorage" />
  </device-transfer>
</data-extraction-rules>
