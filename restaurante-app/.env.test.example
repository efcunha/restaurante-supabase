# Test Database Configuration
# Copy this file to .env.test and fill in your test database credentials

# Supabase Test Database URL
TEST_SUPABASE_URL=https://your-test-project.supabase.co

# Supabase Test Database Anonymous Key
TEST_SUPABASE_ANON_KEY=your-test-anon-key

# Optional: Use same database as development (not recommended for CI/CD)
# If not set, will fall back to EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_ANON_KEY
