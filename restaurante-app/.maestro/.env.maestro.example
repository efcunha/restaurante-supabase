# Copie este arquivo para .maestro/.env.maestro e preencha com os valores reais.
# O arquivo .env.maestro é gitignored — NUNCA commite credenciais reais.

# ── Garcom 01 ────────────────────────────────────────────────────────────────
# Usado em: balcao.yaml, mesa.yaml, pizza.yaml
PLAYWRIGHT_TEST_EMAIL=garcom01@seurestaurante.com
PLAYWRIGHT_TEST_PASSWORD=senha_garcom01

# ── Garcom 02 ────────────────────────────────────────────────────────────────
# Usado em: balcao_garcom02.yaml, mesa_garcom02.yaml, pizza_garcom02.yaml
PLAYWRIGHT_TEST_EMAIL_GARCOM02=garcom02@seurestaurante.com
PLAYWRIGHT_TEST_PASSWORD_GARCOM02=senha_garcom02

# ── Mesa (opcional — sobrescreve o padrão dos flows) ─────────────────────────
# mesa.yaml padrão: NUMERO_MESA=3  (pool garcom01: mesas 1-5)
# mesa_garcom02.yaml padrão: NUMERO_MESA=8  (pool garcom02: mesas 6-10)
# Passe via CLI para sobrescrever: maestro test mesa.yaml --env NUMERO_MESA=5

