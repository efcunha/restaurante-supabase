# Exemplo de configuração de ambiente
# Renomeie este arquivo para .env se estiver usando dotenv, 
# mas para scripts node simples, é melhor exportar no shell.

# Caminho para sua chave de conta de serviço (SEGURANÇA: Mantenha este arquivo fora do repositório!)
GOOGLE_APPLICATION_CREDENTIALS="/caminho/seguro/para/sua/serviceAccountKey.json"

# Para usar:
# export GOOGLE_APPLICATION_CREDENTIALS="/home/seu-usuario/seguranca/serviceAccountKey.json"
# node scripts/seu-script.js
