# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (ops orchestration)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Ops App
# Railway injects PORT in production
PORT=
OPS_PORT=4040
OPS_ENV=development
OPS_PUBLIC_BASE_URL=
OPS_ALLOWED_COMPANY_ID=

# Auth hardening
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Redis for distributed rate limiting (Railway auto-injects via REDIS_URL)
# Format: redis://:password@host:port
# Leave empty or set RATE_LIMIT_FALLBACK_ENABLED=true to use in-memory fallback
REDIS_URL=

# Billing operations rate limiting
# Default: 30 requests per 1 minute
RATE_LIMIT_BILLING_MAX_ATTEMPTS=30
RATE_LIMIT_BILLING_WINDOW_MS=60000

# Enable degradation of rate limiting to memory if Redis unavailable
# Set to 'false' for strict mode (fail-closed with HTTP 503 on protected routes if Redis is down)
OPS_REQUIRE_MFA=false
RATE_LIMIT_FALLBACK_ENABLED=true
