{
  "name": "restaurante-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Backoffice SaaS para clientes, metricas e billing do restaurante-supabase",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/modules/ops-observability-settings.test.js",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "alerts:discord:provision": "node ./scripts/setup-discord-alerts.mjs",
    "billing:candidates": "bash ./scripts/find-billing-candidates.sh",
    "rate-limit:smoke": "bash ./scripts/rate-limit-smoke.sh",
    "rate-limit:smoke:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/rate-limit-smoke.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "cookie": "^1.1.1"
    ,"redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
