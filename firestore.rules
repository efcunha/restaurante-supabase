rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function doesUserBelongToCompany(companyId) {
      // Current implementation: Reads User Doc (1 Extra Read)
      // Optimization TODO: Use Custom Claims in future
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    // Basic Type Checks
    function isNumber(value) {
      return value is number || value is float || value is int;
    }
    
    function isString(value) {
      return value is string && value.size() > 0;
    }

    function isBoolean(value) {
      return value is bool;
    }

    // --- DATA VALIDATION SCHEMAS ---

    function isValidProduct(data) {
       // Allow updates if fields are valid OR if fields are missing (partial update)
       // But for critical fields present, check type.
       
       let validName = !('name' in data) || isString(data.name);
       let validPrice = !('price' in data) || isNumber(data.price);
       let validActive = !('active' in data) || isBoolean(data.active);
       
       // Ensure at least name or price is present on create, but we can iterate.
       return validName && validPrice && validActive;
    }

    // --- COLLECTIONS ---

    // 1. Users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Companies (Root)
    match /companies/{companyId} {
      allow read, write: if request.auth != null && doesUserBelongToCompany(companyId);

      // --- SUB-COLLECTIONS ---
      
      // Cardapio (Products) - STRICT VALIDATION
      match /cardapio/{itemId} {
        allow read: if request.auth != null && doesUserBelongToCompany(companyId);
        allow create, update: if request.auth != null 
                             && doesUserBelongToCompany(companyId)
                             && isValidProduct(request.resource.data);
        allow delete: if request.auth != null && doesUserBelongToCompany(companyId);
      }

      // Settings (Config)
      match /settings/{docId} {
        allow read, write: if request.auth != null && doesUserBelongToCompany(companyId);
      }

      // Pedidos (Orders)
      match /pedidos/{orderId} {
        allow read, write: if request.auth != null && doesUserBelongToCompany(companyId);
      }
      
      // Comandas
      match /comandas/{comandaId} {
        allow read, write: if request.auth != null && doesUserBelongToCompany(companyId);
      }

      // Caixa & Pagamentos & Funcionarios
      // Grouping standard access for others
      match /{collection}/{docId} {
         allow read, write: if request.auth != null && doesUserBelongToCompany(companyId);
      }
    }
  }
}
