rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    // Feature flag para controlar uso de custom claims
    // Quando true, usa custom claims; quando false, usa método antigo
    function useCustomClaims() {
      // Pode ser configurado via environment ou sempre true após migração
      return true;
    }

    function doesUserBelongToCompany(companyId) {
      // Novo método: Custom Claims (0 reads extras)
      if (useCustomClaims() && request.auth.token.companyId != null) {
        return request.auth.token.companyId == companyId;
      }
      
      // Método antigo: Firestore Query (1 read extra) - fallback durante migração
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    // Verifica se usuário tem role específica
    function hasRole(role) {
      if (useCustomClaims() && request.auth.token.role != null) {
        return request.auth.token.role == role;
      }
      // Fallback para método antigo
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.funcao == role;
    }

    // Verifica se usuário tem uma das roles especificadas
    function hasAnyRole(roles) {
      if (useCustomClaims() && request.auth.token.role != null) {
        return request.auth.token.role in roles;
      }
      // Fallback para método antigo
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.funcao;
      return userRole in roles;
    }

    // Basic Type Checks
    function isNumber(value) {
      return value is number || value is float || value is int;
    }
    
    function isString(value) {
      return value is string && value.size() > 0;
    }

    function isBoolean(value) {
      return value is bool;
    }

    // --- DATA VALIDATION SCHEMAS ---

    function isValidProduct(data) {
       let validName = !('name' in data) || isString(data.name);
       let validPrice = !('price' in data) || isNumber(data.price);
       let validActive = !('active' in data) || isBoolean(data.active);
       
       return validName && validPrice && validActive;
    }

    // --- COLLECTIONS ---

    // 1. Users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Companies (Root)
    match /companies/{companyId} {
      allow read, write: if request.auth != null && doesUserBelongToCompany(companyId);

      // --- SUB-COLLECTIONS ---
      
      // Cardapio (Products) - STRICT VALIDATION
      match /cardapio/{itemId} {
        allow read: if request.auth != null && doesUserBelongToCompany(companyId);
        allow create, update: if request.auth != null 
                             && doesUserBelongToCompany(companyId)
                             && isValidProduct(request.resource.data);
        allow delete: if request.auth != null && doesUserBelongToCompany(companyId);
      }

      // Settings (Config)
      match /settings/{docId} {
        allow read, write: if request.auth != null && doesUserBelongToCompany(companyId);
      }

      // Pedidos (Orders) - PROTEÇÃO DO CAMPO isPago
      match /pedidos/{orderId} {
        allow read: if request.auth != null && doesUserBelongToCompany(companyId);
        
        // Create: qualquer usuário autenticado da empresa
        allow create: if request.auth != null && doesUserBelongToCompany(companyId);
        
        // Update: restrições especiais para campo isPago
        allow update: if request.auth != null 
                      && doesUserBelongToCompany(companyId)
                      && (
                        // Se não está modificando isPago, permite
                        !('isPago' in request.resource.data) ||
                        request.resource.data.isPago == resource.data.isPago ||
                        // Se está modificando isPago, requer role admin ou manager
                        hasAnyRole(['admin', 'manager'])
                      );
        
        allow delete: if request.auth != null 
                      && doesUserBelongToCompany(companyId)
                      && hasAnyRole(['admin', 'manager']);
      }
      
      // Comandas
      match /comandas/{comandaId} {
        allow read, write: if request.auth != null && doesUserBelongToCompany(companyId);
      }

      // Caixa & Pagamentos & Funcionarios
      match /{collection}/{docId} {
         allow read, write: if request.auth != null && doesUserBelongToCompany(companyId);
      }
    }
  }
}
