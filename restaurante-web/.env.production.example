# Firebase Configuration - Production Environment
# Copie este arquivo para .env.production

# Firebase Production Project
EXPO_PUBLIC_FIREBASE_API_KEY=your-prod-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-prod-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-prod-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-prod-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-prod-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-prod-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-prod-measurement-id

# Feature Flags - Production (rollout gradual)
EXPO_PUBLIC_FEATURE_CUSTOM_CLAIMS=false
EXPO_PUBLIC_FEATURE_REQUIRE_MFA=false
EXPO_PUBLIC_FEATURE_OPTIMIZED_LISTENERS=false
EXPO_PUBLIC_FEATURE_CACHE_LAYER=false
EXPO_PUBLIC_FEATURE_SERVER_AGGREGATIONS=false
EXPO_PUBLIC_FEATURE_PAGINATION=false
EXPO_PUBLIC_FEATURE_RETRY_LOGIC=false
EXPO_PUBLIC_FEATURE_ARCHIVAL=false
EXPO_PUBLIC_FEATURE_NORMALIZED_FIELDS=false
EXPO_PUBLIC_FEATURE_SERVER_DATEKEY=false
EXPO_PUBLIC_FEATURE_BIOMETRIC_AUTH=false
EXPO_PUBLIC_FEATURE_PERFORMANCE_MONITORING=false

# Debug Settings
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL=error
