FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run storybook:build

FROM node:20-alpine

WORKDIR /app

# Runtime minimalista: apenas o servidor de auth e os arquivos estáticos gerados.
COPY scripts/storybook-static-auth-server.mjs ./scripts/storybook-static-auth-server.mjs
COPY --from=build /app/storybook-static ./storybook-static

ENV NODE_ENV=production
ENV STORYBOOK_STATIC_DIR=storybook-static

EXPOSE 8080

CMD ["node", "scripts/storybook-static-auth-server.mjs"]