# Firebase Configuration - Development Environment
# Copie este arquivo para .env.development

# Firebase Development Project
EXPO_PUBLIC_FIREBASE_API_KEY=your-dev-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-dev-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-dev-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-dev-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-dev-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-dev-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-dev-measurement-id

# Feature Flags - Development (mais permissivo para testes)
EXPO_PUBLIC_FEATURE_CUSTOM_CLAIMS=true
EXPO_PUBLIC_FEATURE_REQUIRE_MFA=false
EXPO_PUBLIC_FEATURE_OPTIMIZED_LISTENERS=true
EXPO_PUBLIC_FEATURE_CACHE_LAYER=true
EXPO_PUBLIC_FEATURE_SERVER_AGGREGATIONS=false
EXPO_PUBLIC_FEATURE_PAGINATION=true
EXPO_PUBLIC_FEATURE_RETRY_LOGIC=true
EXPO_PUBLIC_FEATURE_ARCHIVAL=false
EXPO_PUBLIC_FEATURE_NORMALIZED_FIELDS=false
EXPO_PUBLIC_FEATURE_SERVER_DATEKEY=false
EXPO_PUBLIC_FEATURE_BIOMETRIC_AUTH=false
EXPO_PUBLIC_FEATURE_PERFORMANCE_MONITORING=true

# Fase 5: Phase 12 - Canary auth/order (development default)
EXPO_PUBLIC_FEATURE_LOGIN_UI_NEXT=true
EXPO_PUBLIC_FEATURE_REGISTER_COMPANY_UI_NEXT=true
EXPO_PUBLIC_FEATURE_NOVO_PEDIDO_UI_NEXT=true
EXPO_PUBLIC_FEATURE_DELIVERY_UI_NEXT=true
EXPO_PUBLIC_FEATURE_PAGAMENTO_UI_NEXT=false
EXPO_PUBLIC_FEATURE_COMANDA_GERENCIAMENTO_UI_NEXT=false
EXPO_PUBLIC_FEATURE_ADMIN_UI_NEXT=false

# Fase 6: Billing (development pronto para testes)
EXPO_PUBLIC_FEATURE_BILLING=true
EXPO_PUBLIC_FEATURE_BILLING_SCREEN=true
EXPO_PUBLIC_FEATURE_BILLING_FORCE_BLOCK=false

# Debug Settings
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_LEVEL=debug
