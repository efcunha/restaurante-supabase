{
  "name": "restaurante-web",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "deploy:railway": "bash scripts/deploy-railway.sh",
    "build": "expo export -p web",
    "start": "expo start --web",
    "start:mobile": "expo start",
    "start:web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:supabase": "jest --config jest.config.supabase.js",
    "test:supabase:watch": "jest --config jest.config.supabase.js --watch",
    "test:supabase:coverage": "jest --config jest.config.supabase.js --coverage",
    "test:performance": "jest --config jest.config.performance.js --runInBand",
    "test:performance:watch": "jest --config jest.config.performance.js --watch",
    "test:performance:coverage": "jest --config jest.config.performance.js --coverage",
    "test:e2e": "playwright test",
    "test:stress": "playwright test e2e/stress.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "validate:translations": "ts-node scripts/validate-translations.ts",
    "postinstall": "patch-package",
    "analyze-bundle": "node scripts/analyze-bundle.js",
    "analyze-bundle:build": "node scripts/analyze-bundle.js --build",
    "analyze-bundle:report": "node scripts/analyze-bundle.js --build --report",
    "cleanup": "node scripts/cleanup/cleanup.js",
    "cleanup:dry-run": "node scripts/cleanup/cleanup.js --dry-run",
    "fix-icon-padding": "node scripts/fix-icon-padding.js",
    "generate-icons": "node scripts/generate-android-icons.js",
    "update-splash": "node scripts/update-splash-screen.js",
    "update-icon": "npm run fix-icon-padding && npm run generate-icons",
    "update-all-icons": "npm run fix-icon-padding && npm run generate-icons && npm run update-splash"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/cli-server-api": "20.0.2",
    "@react-native-community/netinfo": "^11.5.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.11.0",
    "@sentry/react-native": "^7.11.0",
    "@supabase/supabase-js": "^2.94.1",
    "@types/react": "~19.1.10",
    "expo": "^54.0.33",
    "expo-application": "^7.0.8",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "^18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "^6.0.20",
    "expo-device": "^8.0.10",
    "expo-font": "^14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-local-authentication": "^17.0.8",
    "expo-modules-core": "~3.0.29",
    "expo-print": "~15.0.8",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "^3.0.9",
    "expo-updates": "^29.0.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.84.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-esc-pos-printer": "^4.5.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.1",
    "serve": "^14.2.5",
    "typescript": "~5.9.2",
    "uuid": "^13.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/mcp": "^0.2.0",
    "@playwright/test": "^1.58.2",
    "@react-native-community/cli": "^11.4.1",
    "@react-native/metro-config": "^0.84.0",
    "@supabase/mcp-server-supabase": "^0.6.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^11.0.0",
    "@types/jest": "^29.5.12",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.34.1",
    "fast-check": "^3.23.2",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "jest-expo": "^32.0.1",
    "lz-string": "^1.5.0",
    "patch-package": "^8.0.1",
    "pixelmatch": "^7.1.0",
    "react-test-renderer": "^19.1.0",
    "sharp": "^0.34.5",
    "ts-jest": "^27.0.3",
    "typescript-eslint": "^7.3.1"
  },
  "overrides": {
    "qs": "^6.15.0",
    "eslint": "$eslint",
    "eslint-plugin-react": "$eslint-plugin-react"
  },
  "engines": {
    "node": ">= 18"
  }
}
