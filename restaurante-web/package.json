{
  "name": "restaurante-web",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "deploy:railway": "bash scripts/deploy-railway.sh",
    "build": "expo export -p web",
    "start": "expo start --web --port 8081",
    "start:mobile": "expo start",
    "start:web": "expo start --web --port 8081",
    "start:web:8081": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-web-8081.ps1",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8081",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test e2e/admin-gerenciar-cardapio.spec.ts --workers=1",
    "audit:e2e:integrity": "node scripts/audit-e2e-integrity.js",
    "test:e2e:mesa:concurrency": "playwright test e2e/mesa-concorrencia-garcons.spec.ts --workers=1",
    "test:e2e:mesa:critical": "playwright test e2e/mesa.spec.ts e2e/mesa-consolidacao.spec.ts e2e/mesa-concorrencia-garcons.spec.ts --workers=1",
    "test:stress": "playwright test e2e/stress.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "postinstall": "patch-package",
    "phase12:profile": "node scripts/phase12-profile.js",
    "phase12:legacy": "node scripts/phase12-profile.js --profile legacy-safe",
    "phase12:auth": "node scripts/phase12-profile.js --profile canary-auth",
    "phase12:ordering": "node scripts/phase12-profile.js --profile canary-ordering",
    "phase12:settlement": "node scripts/phase12-profile.js --profile canary-settlement",
    "phase12:full": "node scripts/phase12-profile.js --profile full-phase12",
    "update-icon": "echo 'Icon update scripts are only supported in restaurante-app'",
    "update-all-icons": "echo 'Icon and splash update scripts are only supported in restaurante-app'"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/cli-server-api": "20.0.2",
    "@react-native-community/netinfo": "^11.5.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.11.0",
    "@sentry/react": "^8.7.0",
    "@sentry/react-native": "^8.7.0",
    "@supabase/supabase-js": "^2.94.1",
    "@types/react": "~19.1.10",
    "expo": "^54.0.33",
    "expo-application": "^7.0.8",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "^18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "^6.0.20",
    "expo-device": "^8.0.10",
    "expo-font": "^14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-local-authentication": "^17.0.8",
    "expo-modules-core": "~3.0.29",
    "expo-print": "~15.0.8",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "^3.0.9",
    "expo-updates": "^29.0.15",
    "firebase": "^12.10.0",
    "i18next": "^25.8.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.8",
    "react-native": "^0.84.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-esc-pos-printer": "^4.5.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.1",
    "serve": "^14.2.6",
    "typescript": "~5.9.2",
    "uuid": "^13.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/mcp": "^0.2.0",
    "@playwright/test": "^1.58.2",
    "@react-native-community/cli": "^11.4.1",
    "@react-native/metro-config": "^0.84.0",
    "@supabase/mcp-server-supabase": "^0.6.3",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.34.1",
    "fast-check": "^4.6.0",
    "globals": "^17.0.0",
    "lz-string": "^1.5.0",
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.57.0"
  },
  "overrides": {
    "qs": "^6.15.0",
    "eslint": "$eslint",
    "eslint-plugin-react": "$eslint-plugin-react",
    "node-forge": "^1.4.0",
    "lodash": "^4.18.1",
    "minimatch": "^9.0.7",
    "brace-expansion": "^5.0.5",
    "picomatch": "^4.0.4",
    "fast-xml-parser": "^5.5.7"
  },
  "engines": {
    "node": ">= 18"
  }
}
