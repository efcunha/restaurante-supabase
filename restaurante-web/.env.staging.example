# Firebase Configuration - Staging Environment
# Copie este arquivo para .env.staging

# Firebase Staging Project
EXPO_PUBLIC_FIREBASE_API_KEY=your-staging-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-staging-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-staging-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-staging-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-staging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-staging-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-staging-measurement-id

# Feature Flags - Staging (testa features antes de produção)
EXPO_PUBLIC_FEATURE_CUSTOM_CLAIMS=true
EXPO_PUBLIC_FEATURE_REQUIRE_MFA=false
EXPO_PUBLIC_FEATURE_OPTIMIZED_LISTENERS=true
EXPO_PUBLIC_FEATURE_CACHE_LAYER=true
EXPO_PUBLIC_FEATURE_SERVER_AGGREGATIONS=true
EXPO_PUBLIC_FEATURE_PAGINATION=true
EXPO_PUBLIC_FEATURE_RETRY_LOGIC=true
EXPO_PUBLIC_FEATURE_ARCHIVAL=true
EXPO_PUBLIC_FEATURE_NORMALIZED_FIELDS=true
EXPO_PUBLIC_FEATURE_SERVER_DATEKEY=true
EXPO_PUBLIC_FEATURE_BIOMETRIC_AUTH=true
EXPO_PUBLIC_FEATURE_PERFORMANCE_MONITORING=true

# Fase 5: Phase 12 - UI-next migration guards
EXPO_PUBLIC_FEATURE_LOGIN_UI_NEXT=false
EXPO_PUBLIC_FEATURE_REGISTER_COMPANY_UI_NEXT=false
EXPO_PUBLIC_FEATURE_NOVO_PEDIDO_UI_NEXT=false
EXPO_PUBLIC_FEATURE_DELIVERY_UI_NEXT=false
EXPO_PUBLIC_FEATURE_PAGAMENTO_UI_NEXT=false
EXPO_PUBLIC_FEATURE_COMANDA_GERENCIAMENTO_UI_NEXT=false
EXPO_PUBLIC_FEATURE_ADMIN_UI_NEXT=false

# Fase 6: Billing / Licensing (staging pronto para QA)
EXPO_PUBLIC_FEATURE_BILLING=true
EXPO_PUBLIC_FEATURE_BILLING_LICENSE_GATE=true
EXPO_PUBLIC_FEATURE_BILLING_SCREEN=true
EXPO_PUBLIC_FEATURE_BILLING_FORCE_BLOCK=false

# Debug Settings
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL=info
