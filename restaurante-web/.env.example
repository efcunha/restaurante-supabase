# Configuração de Ambiente - restaurante-6f221
# Copie este arquivo para .env e use estas credenciais

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
CURSOR_SECRET=generate_with_openssl_rand_hex_32

# Sentry (DSN público - projeto restaurante-web em machado-cunha-soft-house.sentry.io)
EXPO_PUBLIC_SENTRY_DSN=

# WhatsApp Evolution API
# Pode ser com ou sem protocolo; sem protocolo sera normalizado para https://
EXPO_PUBLIC_EVO_API_URL=
EXPO_PUBLIC_EVO_API_KEY=

# MCP / Context7 (optional; improves docs rate limits)
CONTEXT7_API_KEY=

# Playwright E2E credentials (web tests)
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
PLAYWRIGHT_TEST_EMAIL_GARCOM02=
PLAYWRIGHT_TEST_PASSWORD_GARCOM02=
PLAYWRIGHT_TEST_EMAIL_ADMIN=
PLAYWRIGHT_TEST_PASSWORD_ADMIN=

# Feature Flags - Modernização
# Habilite features gradualmente durante rollout

# Fase 1: Security Hardening
EXPO_PUBLIC_FEATURE_CUSTOM_CLAIMS=false
EXPO_PUBLIC_FEATURE_REQUIRE_MFA=false

# Fase 2: Performance Optimization
EXPO_PUBLIC_FEATURE_OPTIMIZED_LISTENERS=false
EXPO_PUBLIC_FEATURE_CACHE_LAYER=false
EXPO_PUBLIC_FEATURE_SERVER_AGGREGATIONS=false
EXPO_PUBLIC_FEATURE_PAGINATION=false
EXPO_PUBLIC_FEATURE_RETRY_LOGIC=false
EXPO_PUBLIC_FEATURE_ARCHIVAL=false

# Fase 3: Data Normalization
EXPO_PUBLIC_FEATURE_NORMALIZED_FIELDS=false
EXPO_PUBLIC_FEATURE_SERVER_DATEKEY=false

# Fase 4: Advanced Features
EXPO_PUBLIC_FEATURE_BIOMETRIC_AUTH=false
EXPO_PUBLIC_FEATURE_PERFORMANCE_MONITORING=false

# Figma Code Connect
# Gere em https://www.figma.com/developers (Settings > Personal access tokens)
FIGMA_TOKEN=
FIGMA_FILE_KEY=

# Fase 5: Phase 12 - UI-next migration guards
EXPO_PUBLIC_FEATURE_LOGIN_UI_NEXT=false
EXPO_PUBLIC_FEATURE_REGISTER_COMPANY_UI_NEXT=false
EXPO_PUBLIC_FEATURE_NOVO_PEDIDO_UI_NEXT=false
EXPO_PUBLIC_FEATURE_DELIVERY_UI_NEXT=false
EXPO_PUBLIC_FEATURE_PAGAMENTO_UI_NEXT=false
EXPO_PUBLIC_FEATURE_COMANDA_GERENCIAMENTO_UI_NEXT=false
EXPO_PUBLIC_FEATURE_ADMIN_UI_NEXT=false

# Fase 6: Billing / Licensing
EXPO_PUBLIC_FEATURE_BILLING=false
EXPO_PUBLIC_FEATURE_BILLING_LICENSE_GATE=false
EXPO_PUBLIC_FEATURE_BILLING_SCREEN=false

# Fase 7: PDV (maquininha externa / TEF)
EXPO_PUBLIC_FEATURE_PDV_ENABLED=false
EXPO_PUBLIC_FEATURE_PDV_DEVICE_PAYMENT=false
EXPO_PUBLIC_FEATURE_PDV_SCALE=false
EXPO_PUBLIC_FEATURE_PDV_SCALE_ENABLED=false
EXPO_PUBLIC_FEATURE_BALANCA=false
EXPO_PUBLIC_FEATURE_PDV_EXTERNAL_POS=false
EXPO_PUBLIC_FEATURE_PDV_SELF_SERVICE_SCALE=false
# URL do bridge de balanca (ex.: http://localhost:3031)
EXPO_PUBLIC_SCALE_BRIDGE_URL=

# Endpoint do restaurante-ops para TEF/maquininha integrada
EXPO_PUBLIC_OPS_BASE_URL=
# Modo simulacao de maquininha (apenas QA)
EXPO_PUBLIC_PDV_DEVICE_SIMULATION=false

# ==========================================
# Observabilidade — restaurante-ops
# ==========================================
# Endpoint do restaurante-ops para ingestao de logs (seguro expor ao bundle)
EXPO_PUBLIC_OPS_LOGS_ENDPOINT=https://ops.restaurante-web.app.br
# API key de ingestao (escrita de logs apenas — sem acesso ao dashboard)
EXPO_PUBLIC_LOG_API_KEY=
