{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && bash ./scripts/sync-latest-eas-builds.sh && npm run build"
  },
  "deploy": {
    "startCommand": "npx serve out -s -l $PORT",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
