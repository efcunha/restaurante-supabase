# Porta serial da balanca
# Windows: COM3, COM4...
# Linux: /dev/ttyUSB0
BALANCA_PORT=COM3

# Baud rate (tipico 2400 ou 9600)
BALANCA_BAUD=9600

# Protocolo: PRT1 | PRT2 | PRT3
BALANCA_PROTO=PRT2

# Porta HTTP do bridge
API_PORT=3031

# Chave opcional de protecao. Se definida, exige header x-api-key.
API_KEY=

# Origem permitida (opcional)
# Exemplo: http://localhost:19006,https://seu-dominio.com
ALLOWED_ORIGINS=
